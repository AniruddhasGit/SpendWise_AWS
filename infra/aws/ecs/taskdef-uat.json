{
  "containerDefinitions": [
    {
      "name": "spendwise-uat",
      "image": "944483082287.dkr.ecr.ap-south-1.amazonaws.com/spendwise:v3",
      "cpu": 0,
      "memory": 384,
      "memoryReservation": 192,
      "portMappings": [
        {
          "containerPort": 8000,
          "hostPort": 8001,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "environment": [
        {
          "name": "APP_TIMEZONE",
          "value": "Asia/Kolkata"
        },
        {
          "name": "BOOTSTRAP_ADMIN_EMAIL",
          "value": "admin@spendwise.test"
        },
        {
          "name": "COOKIE_SECURE",
          "value": "false"
        },
        {
          "name": "EXPOSE_VERSION",
          "value": "uat"
        },
        {
          "name": "LOG_LEVEL",
          "value": "INFO"
        },
        {
          "name": "SPENDWISE_DOTENV",
          "value": "0"
        },
        {
          "name": "UVICORN_WORKERS",
          "value": "1"
        }
      ],
      "mountPoints": [],
      "volumesFrom": [],
      "secrets": [
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:ssm:ap-south-1:944483082287:parameter/spendwise/uat/DATABASE_URL"
        },
        {
          "name": "MIGRATION_DATABASE_URL",
          "valueFrom": "arn:aws:ssm:ap-south-1:944483082287:parameter/spendwise/uat/MIGRATION_DATABASE_URL"
        },
        {
          "name": "JWT_SECRET",
          "valueFrom": "arn:aws:ssm:ap-south-1:944483082287:parameter/spendwise/uat/JWT_SECRET"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/spendwise-uat",
          "awslogs-region": "ap-south-1",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "curl -f http://localhost:8000/healthz || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 120
      },
      "systemControls": []
    }
  ],
  "family": "spendwise-uat",
  "taskRoleArn": "arn:aws:iam::944483082287:role/spendwise-ecs-task-role",
  "executionRoleArn": "arn:aws:iam::944483082287:role/spendwise-ecs-exec-uat",
  "networkMode": "bridge",
  "volumes": [],
  "placementConstraints": [],
  "requiresCompatibilities": [
    "EC2"
  ]
}

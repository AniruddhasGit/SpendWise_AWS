  "admin_access": {
    "source": "SW-ADR-129 (supersedes SW-ADR-129, restores SW-ADR-043) · SRC-001 §4.5",
    "note": "An admin sees counts and dates, never an amount or a description. A row-level policy has NO column dimension and therefore cannot express that; a function's return type can. `app.is_admin` is consulted by no policy on a money table and is never set on a request-scoped connection.",
    "policies_on_money_tables": false,
    "functions": [
      {
        "name": "admin_expense_stats",
        "purpose": "expenses: an admin reads COUNT and LAST ACTIVITY DATE only (SW-ADR-129). This is the whole of admin access to the money table.",
        "args": "target_user_id BIGINT",
        "argtypes": "BIGINT",
        "returns": "expense_count BIGINT, last_activity DATE",
        "body": "SELECT count(*)::bigint, max(spent_on)\n      FROM expenses WHERE user_id = target_user_id;"
      }
    ]
  },

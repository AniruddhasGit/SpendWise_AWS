# machine-specific: holds an absolute path to the local hook
.claude/settings.local.json

# secrets — never commit
.env
.env.*
!.env.example

# python
__pycache__/
*.py[cod]
.venv/
venv/
# editable-install build metadata — regenerated by `pip install -e .`
*.egg-info/
build/

# node
node_modules/
dist/

# os
.DS_Store
Thumbs.db

# probe file written by a test
.env.probe

# your RDS master password - never committed
rds.txt

# local login notes (app accounts + passwords) - never committed, anywhere in the tree
passwords.txt
**/passwords.txt

# ── the other two environments, as nested git worktrees ──────────────────────
# `dev/` and `uat/` are working directories for the dev and uat branches, living
# inside this one so all three environments sit together. They are NOT copies of
# the code — one repository, three checkouts. Ignored here because from main's
# point of view they are somebody else's working tree.
/dev/
/uat/

# impeccable decision-page runtime files
.impeccable/questions/
.impeccable/decision-direction.json
.impeccable/review/

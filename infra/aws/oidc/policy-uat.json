{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EcrLoginIsAccountWideByDesign",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "ReadTheImageAndStampItUatOk",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchGetImage",
        "ecr:DescribeImages",
        "ecr:PutImage"
      ],
      "Resource": "arn:aws:ecr:ap-south-1:944483082287:repository/spendwise"
    },
    {
      "Sid": "RegisterTaskDefinitionHasNoResourceArn",
      "Effect": "Allow",
      "Action": [
        "ecs:RegisterTaskDefinition",
        "ecs:DescribeTaskDefinition"
      ],
      "Resource": "*"
    },
    {
      "Sid": "UpdateOnlyTheUatService",
      "Effect": "Allow",
      "Action": [
        "ecs:UpdateService",
        "ecs:DescribeServices"
      ],
      "Resource": "arn:aws:ecs:ap-south-1:944483082287:service/spendwise-cluster/spendwise-uat"
    },
    {
      "Sid": "WatchTasksInThisClusterOnly",
      "Effect": "Allow",
      "Action": "ecs:ListTasks",
      "Resource": "*",
      "Condition": {
        "ArnEquals": {
          "ecs:cluster": "arn:aws:ecs:ap-south-1:944483082287:cluster/spendwise-cluster"
        }
      }
    },
    {
      "Sid": "DescribeTasksInThisClusterOnly",
      "Effect": "Allow",
      "Action": "ecs:DescribeTasks",
      "Resource": "arn:aws:ecs:ap-south-1:944483082287:task/spendwise-cluster/*",
      "Condition": {
        "ArnEquals": {
          "ecs:cluster": "arn:aws:ecs:ap-south-1:944483082287:cluster/spendwise-cluster"
        }
      }
    },
    {
      "Sid": "PassOnlyThisEnvironmentsRolesAndOnlyToEcsTasks",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::944483082287:role/spendwise-ecs-exec-uat",
        "arn:aws:iam::944483082287:role/spendwise-ecs-task-role"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ecs-tasks.amazonaws.com"
        }
      }
    }
  ]
}

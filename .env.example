# SpendWise — the committed environment manifest (P-OPS-01 / SW-ADR-060).
#
# Copy to `.env` and fill in. `.env` is gitignored and MUST NEVER be committed.
# A test imports app.core.settings.Settings and diffs it against this file in
# BOTH directions, so this list cannot drift from the code:
#   a variable the code reads and this file omits  = a deploy that fails at 3am
#   a variable this file lists and no code reads   = a lie a reader will act on
#
# In AWS these live in SSM Parameter Store as SecureString, not in a file
# (docs/30 Deployment/AWS_PREP_QUEUE.md items 7 and 14).

## ─── REQUIRED — the application refuses to start without these ───────────

# Runtime role. Owns no table, is not superuser, holds no BYPASSRLS — asserted
# against the catalog at boot (P-OPS-02). Must be the asyncpg driver.
DATABASE_URL=postgresql+asyncpg://spendwise_app:CHANGE_ME@localhost:5432/spendwise

# Owner role. Runs migrations and NOTHING else — it never serves a request.
# Two roles means two connection strings; SW-ADR-081. This is the third SSM
# parameter that prep-queue item 14 exists for.
MIGRATION_DATABASE_URL=postgresql+asyncpg://spendwise_owner:CHANGE_ME@localhost:5432/spendwise

# Session signing secret. Rotating it revokes every live session, by design:
# the fingerprint is stored in app_meta and compared at boot (SW-ADR-125).
# Generate with:  py -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_at_least_32_bytes_long_see_the_command_above

## ─── OPTIONAL — sensible defaults, no abort ──────────────────────────────

# The one address that may claim admin while zero administrators exist
# (P-ACC-02). Set it to an address NOBODY REGISTERS in the gate environment —
# the seed creates exactly two people, per SRC-001 ERRATUM E-6.
# Unset AND no admin present is a refusal to start, checked at boot.
BOOTSTRAP_ADMIN_EMAIL=

# Sets `Secure` on the session cookie. Default false because SW-ADR-014 left
# the deployment without TLS — a RECORDED WEAKNESS, never a default to copy.
# Turn it on the day TLS exists.
COOKIE_SECURE=false

# The calendar every boundary is computed in (SW-ADR-096). Irreversible on the
# write path once real rows exist: the submission instant is never stored, so
# rows misfiled across a day boundary can never be identified afterwards.
APP_TIMEZONE=Asia/Kolkata

# Pins "today" for the browser-observed day-one gate (CV-14, CV-20).
# Bare ISO date. MUST be absent in production.
# APP_TODAY_OVERRIDE=2026-08-05
APP_TODAY_OVERRIDE=

LOG_LEVEL=INFO

# Build identifier returned by /readyz. Unset reports the literal `unset` and
# logs one WARN (P-OPS-03, SW-ADR-064).
EXPOSE_VERSION=

## ─── RATE LIMITS — SW-ADR-128. Every number here is EFFECTIVE ────────────

# Master switch. Leave it on. Off means every auth endpoint is brute-forceable,
# which is the state this application shipped in until E1-S6.
RATE_LIMIT_ENABLED=true

# The divisor, NOT a uvicorn flag — set it to the number of workers you actually
# run. slowapi/limits store counters in-process, so two workers hold two
# counters and a limit configured at 5 admits 10 between them. The values below
# are what a person experiences; the app divides by this to get what it
# configures. Set this wrong and the effective limit is wrong by that factor.
UVICORN_WORKERS=2

# Sign-in, keyed TWICE: per IP and per normalised email. Per-IP alone is
# bypassed by ten addresses; per-email alone lets one host walk an account list.
RATE_LIMIT_LOGIN_PER_MIN=10
RATE_LIMIT_LOGIN_EMAIL_PER_MIN=10

# Registration, two windows. 5/min alone still permits 7,200 accounts a day.
RATE_LIMIT_REGISTER_PER_MIN=5
RATE_LIMIT_REGISTER_PER_DAY=20

# Reset redemption — the tightest, because a reset token is a bearer credential
# and this is where guessing pays best (SRC-001 §10.7, §10.9).
RATE_LIMIT_RESET_PER_MIN=6

# Everything else. Static assets are never limited.
RATE_LIMIT_API_USER_PER_MIN=120
RATE_LIMIT_API_IP_PER_MIN=60

## ─── OPTIONAL AND DEGRADING — absence disables a feature, loudly ─────────

# Receipt storage. Absent disables receipt upload, logs ONE WARN naming the
# disabled feature, and makes P-ACC-06 report receipts_enabled=false so the
# client hides the control rather than letting it fail. It does NOT abort.
S3_BUCKET=
